        Outfits = {
            {Name = "👕 Вариант 1", ShirtId = 113791677446021, PantsId = 98356572400331},
            {Name = "👕 Вариант 2", ShirtId = 100899893266277, PantsId = 133930001642126},
        },
        AccessoryIDs = {135035770185274},
        R6ExclusiveIDs = {113581820997706, 102607153727345, 94828195843199},
        Emotions = {
            {Name = "😉 Подмигивание", Id = 108765460813211},
            {Name = "😐 Нейтральное", Id = 103446823336775},
